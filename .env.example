# PawRadar environment variables
# Copy this file to .env and fill in your own values.

# Database connection string.
#
# Production on Vercel uses Neon Postgres:
#   1. Go to https://neon.tech and create a project
#   2. Copy the connection string
#   3. Add it to Vercel Environment Variables as DATABASE_URL
#
DATABASE_URL=""

# 32+ random characters. Server only; never expose with NEXT_PUBLIC_.
SESSION_SECRET=""

# Optional distinct HMAC key for hashing rate-limit identifiers. Falls back to
# SESSION_SECRET when omitted.
RATE_LIMIT_SECRET=""

# Public OneSignal Web App ID. Leaving it blank disables the entire push UI.
NEXT_PUBLIC_ONESIGNAL_APP_ID=""

# OneSignal REST API key. Server only; never commit or paste into client code.
ONESIGNAL_REST_API_KEY=""
