// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Canonical provider: PostgreSQL (Neon in production).
  // Local development uses a disposable PostgreSQL database or branch; do not
  // edit this provider in-place because Prisma clients are provider-specific.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  active
  cancelled
}

enum SubscriptionState {
  active
  muted
  revoked
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  igHandle       String?
  password       String
  sessionVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events Event[]
}

model Event {
  id          String      @id @default(cuid())
  slug        String      @unique
  petName     String
  ownerHandle String
  walkStart   DateTime
  walkEnd     DateTime
  location    String
  notes       String?
  status      EventStatus @default(active)
  addCount    Int         @default(0)
  ownerId     String?
  owner       User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  subscriptions Subscription[]

  @@index([ownerId])
}

model Subscription {
  id                   String            @id @default(cuid())
  onesignalSubscriptionId String
  eventId              String
  event                Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  state                SubscriptionState @default(active)
  unsubscribeTokenHash String            @unique
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([onesignalSubscriptionId, eventId])
  @@index([eventId, state])
}

/// Durable fixed-window buckets used by public and authentication endpoints.
/// Rows are intentionally opaque: keys are HMAC-hashed before storage.
model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
